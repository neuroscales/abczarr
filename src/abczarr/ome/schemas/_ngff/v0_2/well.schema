{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngff.openmicroscopy.org/0.2/schemas/well.schema",
  "$comment": "abczarr reconstruction, NOT an official NGFF artifact. NGFF 0.2 published no distinct JSON schema (its version pointer resolves to a 0.6.dev release). Derived from the official 0.1 schema by bumping the version identifier to 0.2. The only normative 0.1->0.2 change was the requirement that arrays be 5D in tczyx order; the multiscales JSON structure was unchanged (the `axes` list was introduced in 0.3).",
  "title": "OME-NGFF well schema",
  "description": "JSON from OME-NGFF .zattrs",
  "type": "object",
  "properties": {
    "well": {
      "type": "object",
      "properties": {
        "images": {
          "description": "The fields of view for this well",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "acquisition": {
                "description": "A unique identifier within the context of the plate",
                "type": "integer"
              },
              "path": {
                "description": "The path for this field of view subgroup",
                "type": "string",
                "pattern": "^[A-Za-z0-9]+$"
              }
            },
            "required": [
              "path"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "version": {
          "description": "The version of the specification",
          "type": "string",
          "enum": [
            "0.2"
          ]
        }
      },
      "required": [
        "images"
      ]
    }
  }
}
